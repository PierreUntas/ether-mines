<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the game's pure C# core (Assets/Scripts/Core, no UnityEngine) outside Unity, and checks it
       against the web version's JavaScript, block for block. Run: dotnet run (from unity/CoreTests). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
